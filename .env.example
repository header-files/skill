DEFAULT_MODEL=chatgpt

# OpenAI-compatible Chat Completions
MODEL_CHATGPT_PROTOCOL=openai-completions
MODEL_CHATGPT_NAME=gpt-4o-mini
MODEL_CHATGPT_BASE_URL=https://api.openai.com/v1
MODEL_CHATGPT_API_KEY=sk-your-key
MODEL_CHATGPT_TIMEOUT_SECONDS=60

# Example: OpenAI Responses API
# MODEL_RESPONSES_PROTOCOL=openai-responses
# MODEL_RESPONSES_NAME=gpt-4o-mini
# MODEL_RESPONSES_BASE_URL=https://api.openai.com/v1
# MODEL_RESPONSES_API_KEY=sk-your-key

# Example: Anthropic Messages
# MODEL_CLAUDE_PROTOCOL=anthropic-messages
# MODEL_CLAUDE_NAME=claude-3-5-sonnet-latest
# MODEL_CLAUDE_BASE_URL=https://api.anthropic.com
# MODEL_CLAUDE_API_KEY=sk-ant-your-key
# MODEL_CLAUDE_ANTHROPIC_VERSION=2023-06-01

# Logging (shared)
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# LOG_FORMAT=%(asctime)s | %(levelname)s | %(trace_id)s | %(name)s | %(message)s
# LOG_ENSURE_FIELDS=trace_id

# Embedding
# 支持的 PROTOCOL（本期唯一，也是缺省）：openai-embeddings
#   POST {base}/embeddings ，body: model / input
DEFAULT_EMBEDDING=bge
EMBEDDING_BGE_PROTOCOL=openai-embeddings
EMBEDDING_BGE_NAME=bge-m3
EMBEDDING_BGE_BASE_URL=https://api.example.com/v1
EMBEDDING_BGE_API_KEY=sk-your-embedding-key
EMBEDDING_BGE_TIMEOUT_SECONDS=60
# EMBEDDING_BGE_DIMENSIONS=1024

# Rerank
# 支持的 PROTOCOL：
#   cohere-rerank（缺省）—— POST {base}/rerank
#   dashscope-text-rerank —— 阿里云百炼 text-rerank
#     POST {base}/services/rerank/text-rerank/text-rerank
# RAG_RERANK_ENABLED 默认 true，一次问答会多一次上游调用
DEFAULT_RERANK=cohere
RERANK_COHERE_PROTOCOL=cohere-rerank
RERANK_COHERE_NAME=rerank-v3.5
RERANK_COHERE_BASE_URL=https://api.example.com/v1
RERANK_COHERE_API_KEY=sk-your-rerank-key
RERANK_COHERE_TIMEOUT_SECONDS=60

# 阿里云百炼 text-rerank 示例
# DEFAULT_RERANK=qwen
# RERANK_QWEN_PROTOCOL=dashscope-text-rerank
# RERANK_QWEN_NAME=qwen3.7-text-rerank
# RERANK_QWEN_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
# RERANK_QWEN_API_KEY=sk-your-dashscope-key
# RERANK_QWEN_INSTRUCT=Given a web search query, retrieve relevant passages that answer the query.

# RAG 流水线
RAG_CHAT_MODEL=chatgpt
RAG_EMBEDDING_MODEL=bge
RAG_RERANK_MODEL=cohere
RAG_RERANK_ENABLED=true
RAG_VECTOR_STORE=faiss
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# RAG_CHUNK_SEPARATORS=\n\n|\n|。|！|？|. | |
RAG_EMBED_BATCH_SIZE=16
RAG_RETRIEVE_TOP_K=20
RAG_RERANK_TOP_N=5
RAG_QUERY_REWRITE_ENABLED=false
# RAG_QUERY_REWRITE_MODEL=chatgpt
# RAG_QUERY_REWRITE_PROMPT=你是检索查询改写助手。...
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_HISTORY_TURNS=10
RAG_MAX_UPLOAD_BYTES=20971520
# RAG_SYSTEM_PROMPT=你是知识库问答助手。

# Skill Runtime（多根用冒号分隔）
# SKILL_ROOTS=/path/to/skills
# SKILL_CHAT_MODEL=chatgpt
# SKILL_FINGERPRINT_MODE=content
# SKILL_SCRIPT_TIMEOUT_SECONDS=30
# SKILL_SCRIPT_MAX_CONCURRENT=4
# SKILL_SCRIPT_MAX_OUTPUT_BYTES=1048576
# SKILL_AGENT_MAX_STEPS=20
# SKILL_AGENT_TIMEOUT_SECONDS=300
# SKILL_READ_MAX_BYTES=1048576

# 公共 HTTP
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=120
